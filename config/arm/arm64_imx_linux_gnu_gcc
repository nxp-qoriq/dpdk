[binaries]
c = ['ccache', 'aarch64-none-linux-gnu-gcc']
cpp = ['ccache', 'aarch64-none-linux-gnu-g++']
ar = 'aarch64-none-linux-gnu-ar'
as = 'aarch64-none-linux-gnu-as'
strip = 'aarch64-none-linux-gnu-strip'
pkgconfig = 'aarch64-linux-gnu-pkg-config'
pcap-config = ''

[host_machine]
system = 'linux'
cpu_family = 'aarch64'
cpu = 'armv8.2-a'
endian = 'little'

[properties]
platform = 'imx'
